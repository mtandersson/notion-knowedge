# Allowlist only the committed Rust workspace inputs. Credentials, .env files,
# model/index/state data, Git, target/, documentation and test tooling stay out.
**
!Cargo.toml
!Cargo.lock
!crates/**/Cargo.toml
!crates/**/*.rs
!crates/**/*.sql
!vendor/arrow-ipc/**/Cargo.toml
!vendor/lance-encoding/**/Cargo.toml
!vendor/arrow-ipc/**/Cargo.toml.orig
!vendor/lance-encoding/**/Cargo.toml.orig
!vendor/arrow-ipc/**/*.rs
!vendor/lance-encoding/**/*.rs
!vendor/arrow-ipc/**/*.md
!vendor/lance-encoding/**/*.md
!vendor/arrow-ipc/**/LICENSE
!vendor/lance-encoding/**/LICENSE
!vendor/arrow-ipc/**/LICENSE.txt
!vendor/lance-encoding/**/LICENSE.txt
!vendor/arrow-ipc/**/NOTICE.txt
!vendor/lance-encoding/**/NOTICE.txt
!vendor/README.md
!vendor/lance-encoding/protos/*.proto
# Never allow common credential files, even inside an otherwise allowed tree.
**/.env*
**/*.pem
**/*.key
**/credentials*

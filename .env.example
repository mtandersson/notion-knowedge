# Export these variables in your shell or service configuration.
# The server does not load .env files automatically.

# Optional; defaults shown. These configure the HTTP listener enabled by --http.
# The server uses stdio by default and does not open an HTTP listener.
NK_HTTP_HOST=127.0.0.1
NK_HTTP_PORT=3000

# Shared SIGINT/SIGTERM cleanup budget for HTTP/workers and operator commands (1..3600 seconds).
NK_SHUTDOWN_TIMEOUT_SECONDS=30

# MCP tool access policy: true (default; only audited read tools) or false.
# Setting false only permits installed mutation tools; it does not add any.
NK_READ_ONLY=true

# Optional: none (default) or integration. OAuth is implemented separately.
# The bootstrap validates this configuration but does not call Notion yet.
NK_NOTION_AUTH=none
# Required only with NK_NOTION_AUTH=integration. Never commit a real token.
# NOTION_TOKEN=replace-with-your-notion-integration-token

# Required for verified webhook mode: persistent local SQLite inbox.
# NK_WEBHOOK_STATE_FILE=/absolute/private/path/operational-state.sqlite

# Page content/property event quiet period and maximum sustained burst delay (milliseconds).
NK_WEBHOOK_DEBOUNCE_MS=5000
NK_WEBHOOK_MAX_DELAY_MS=30000

# Optional development/emergency fallback for the HTTP MCP endpoint only.
# Disabled by default. Use a randomly generated URL-safe secret (>=32 chars).
# Never expose a plaintext bearer across the public network.
# NK_HTTP_AUTH=bearer
# NK_HTTP_BEARER_TOKEN=<random-url-safe-secret>
# Diagnostics are independent; only use bearer when NK_HTTP_AUTH=bearer.
# NK_HTTP_HEALTH_AUTH=none

# Opt-in Unix production worker (build with --features webhook-worker).
# NK_WEBHOOK_WORKER=true
# NK_WEBHOOK_INDEX_DIR=/absolute/private/index
# NK_WEBHOOK_QWEN_ASSETS=/absolute/qwen-assets
# NK_WEBHOOK_POLL_MS=1000
# NK_WEBHOOK_TIMEOUT_SECONDS=60
# NK_NOTION_SCOPE_EXCLUDED_PAGES=canonical-uuid
# NK_NOTION_SCOPE_EXCLUDED_DESCENDANTS=canonical-uuid

# Optional authoritative periodic reconciliation in --http (webhook-worker build).
# Requires Notion integration/root scope and local index/Qwen/state settings above.
# Webhook processing itself may stay disabled. Deadlines/history survive restart.
# NK_RECONCILIATION_INTERVAL_SECONDS=3600
# NK_RECONCILIATION_MAX_ATTEMPTS=4
# NK_RECONCILIATION_BACKOFF_SECONDS=5
# NK_RECONCILIATION_MAX_BACKOFF_SECONDS=300

# Immutable MCP upload maximum: 1..16, default 4.
# NK_MAX_UPLOAD_FILES=4
# Opt-in audited file ingestion: trusted stdio or authenticated loopback bearer HTTP.
# NK_FILE_INGESTION=true requires write mode, integration and full physical scope.
# NK_FILE_SOURCE_HOSTS=files.example.test
# NK_FILE_TIMEOUT_SECONDS=30
# NK_FILE_PLAN=free
# NK_FILE_MAX_BYTES=5242880
# NK_FILE_AUDIT_FILE=/absolute/private/durable/audit.sqlite
# NK_FILE_AUDIT_RETENTION_DAYS=30
# Paid multipart requires paired validated bounds.
# NK_FILE_MULTIPART_THRESHOLD_BYTES=20971520
# NK_FILE_PART_BYTES=5242880

# Explicit read activation of existing compatible worker-owned index/state/Qwen.
# Requires Unix webhook-worker build; no webhook admission is required.
NK_RETRIEVAL=false

# Optional bounded bilingual expansion; requires configured retrieval/indexing.
# Prepare a separately attributed pinned bundle with the matching server build.
NK_LEXICAL_EXPANSION=false
# NK_LEXICAL_ASSET_BUNDLE=/absolute/path/lexical.bundle
# NK_LEXICAL_ASSET_SHA256=<lowercase-bundle-sha256>
# NK_LEXICAL_MAX_REQUESTS=1

# Explicit graph-only navigation from existing worker-bound index/SQLite state.
# Requires trusted workspace/roots and Unix webhook-worker build; no Qwen model.
# HTTP additionally requires authenticated loopback bearer mode.
NK_GRAPH=false

# Optional staged /authorize entry point (no callback, token or MCP access yet).
# Requires the complete NK_NOTION_OAUTH_* and allowed user/workspace policy.
# Register the real exact MCP client callback out of band.
# NK_OAUTH_CLIENT_ID=chatgpt
# NK_OAUTH_CLIENT_REDIRECT_URI=https://chatgpt.example.com/callback

# Export these variables in your shell or service configuration.
# The server does not load .env files automatically.

# Optional; defaults shown. These configure the HTTP listener enabled by --http.
# The server uses stdio by default and does not open an HTTP listener.
NK_HTTP_HOST=127.0.0.1
NK_HTTP_PORT=3000

# MCP tool access policy: true (default; only audited read tools) or false.
# Setting false only permits installed mutation tools; it does not add any.
NK_READ_ONLY=true

# Optional: none (default) or integration. OAuth is implemented separately.
# The bootstrap validates this configuration but does not call Notion yet.
NK_NOTION_AUTH=none
# Required only with NK_NOTION_AUTH=integration. Never commit a real token.
# NOTION_TOKEN=replace-with-your-notion-integration-token

# Required for verified webhook mode: persistent local SQLite inbox.
# NK_WEBHOOK_STATE_FILE=/absolute/private/path/operational-state.sqlite

# Page content/property event quiet period and maximum sustained burst delay (milliseconds).
NK_WEBHOOK_DEBOUNCE_MS=5000
NK_WEBHOOK_MAX_DELAY_MS=30000
